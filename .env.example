# 司南 · 环境变量模板
#
# 用法：
#     cp .env.example .env
#     然后填入真实值（.env 已被 .gitignore 排除，不会进版本库）
#
# ★ 这个文件是**部署清单的一半**。另一半是 Dockerfile 和
#   `司南_技术账本与补课清单.md` 里 L12 的「上线前检查表」。
#
# ⚠️ 为什么要有这个模板：
#   没有它，新人（或半年后的你）拿到仓库会不知道要配哪些变量，
#   只能去翻代码里的 os.getenv()——而漏配往往是**运行时才炸**，
#   甚至不炸只是功能静默降级（比如忘了配 embedding，检索就悄悄退回稀疏）。
#   模板的价值是把「隐式依赖」变成「显式清单」。

# ============================================================
# 一、必填：模型服务
# ============================================================
# 推理模型（Agent 主脑、汇报解析、笔记摘要）
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 视觉模型 + 备用 embedding（智谱）
# 申请：https://open.bigmodel.cn
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 联网搜索（本地知识库覆盖不到时的兜底）
# 申请：https://tavily.com
TAVILY_API_KEY=

# ============================================================
# 二、知识库 embedding（L11）
# ============================================================
# provider 可选：siliconflow | zhipu | openai | none
# 留空则自动探测（siliconflow → zhipu → openai）
KB_EMBED_PROVIDER=siliconflow
KB_EMBED_MODEL=BAAI/bge-m3

# 申请：https://siliconflow.cn   （BAAI/bge-m3 为 1024 维中文模型）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ============================================================
# 三、可选：可观测性（LangSmith 链路追踪）
# ============================================================
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=sinan

# ============================================================
# 四、可选：文件上传（阿里云 OSS，照片汇报用）
# ============================================================
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# ============================================================
# 五、日志与重规划参数
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# 六、上线必改（本地开发全部可以留空）
# ============================================================
# 环境标识：设为 prod 时启动脚本会监听 0.0.0.0 而非 127.0.0.1
SINAN_ENV=dev

# 访问令牌：**部署到公网前必须设置**，否则任何人都能调用你的 API
# （拿到令牌的人仍可传任意 user_id —— 见 main.py 里 auth_middleware 的作业注释）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SINAN_API_TOKEN=

# 允许的前端来源（逗号分隔）。留空 = 通配，仅限本地开发
# 例：SINAN_ALLOWED_ORIGINS=https://sinan.example.com,http://localhost:8001
SINAN_ALLOWED_ORIGINS=

# 容器里的监听端口（多数平台会自动注入 PORT）
PORT=8001

# ============================================================
# 七、功能开关（默认关闭，用于新旧实现对比）
# ============================================================
# 走 StateGraph 业务编排图（L7/L8）；不设则走原始 if-elif 路径
SINAN_USE_GRAPH=1

# 掌握度画像存到 LangGraph Store（L10）；不设则存 mastery 表
SINAN_USE_STORE=0
